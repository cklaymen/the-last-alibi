# Docker / Cloudflare Tunnel deployment. Copy to `.env` on the server.
# Public address of the app (used for CORS in the API and Socket.IO).
WEB_ORIGIN=https://cluedo.example.com
# Token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel.
TUNNEL_TOKEN=
# Host port (localhost only), handy for debugging on the server.
WEB_PORT=8080
PRESENCE_GRACE_MS=30000
