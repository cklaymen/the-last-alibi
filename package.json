{
  "name": "mystery-game",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @mystery-game/game --filter @mystery-game/contracts build && pnpm --filter @mystery-game/e2e e2e",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "turbo": "^2.6.0",
    "typescript": "^5.9.0"
  }
}
